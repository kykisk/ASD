datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SYSTEM_ADMIN
  FAMILY_ADMIN
  FAMILY_MEMBER
  THERAPIST
}

enum OAuthProvider {
  GOOGLE
  KAKAO
  APPLE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String
  role             UserRole  @default(FAMILY_ADMIN)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  phone            String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  familyMembers    FamilyMember[]
  legalConsents    LegalConsent[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  wellbeingCheckins ParentWellbeing[]
  activityComments  ActivityComment[]
  roleAssignments   RoleAssignment[]  @relation("AssignedToUser")
  createdRoleAssignments RoleAssignment[] @relation("AssignedByUser")

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  deviceInfo String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

enum ScheduleCategory {
  THERAPY
  EDUCATION
  FREE_PLAY
  MEAL
  SLEEP
  OTHER
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  SPECIFIC_DAYS
  CUSTOM
}

enum QuestionnaireType {
  LICENSED
  NON_LICENSED_USER_INPUT
  NON_LICENSED_AI_GENERATED
}

enum AssessmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ActivityResult {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum CurriculumStatus {
  PENDING
  GENERATED
  CONFIRMED
  COMPLETED
  FAILED
}

enum BatchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── FAMILY ─────────────────────────────────────────────

enum AiTier {
  DISABLED
  BASIC
  STANDARD
  UNLIMITED
}

model Family {
  id        String   @id @default(cuid())
  name      String
  aiTier    AiTier   @default(STANDARD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        FamilyMember[]
  children       Child[]
  schedules      Schedule[]
  questionnaires Questionnaire[]
  assessments    Assessment[]
  curricula      Curriculum[]
  reports        Report[]
  wellbeingCheckins ParentWellbeing[]
  emergencyEvents  EmergencyEvent[]
  researchMatches  ResearchUserMatch[]
  researchDigests  ResearchDigest[]
  roleAssignments  RoleAssignment[]
  licenses         License[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  role      UserRole @default(FAMILY_MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([userId])
  @@index([familyId])
}

// ─── CHILD ──────────────────────────────────────────────

model Child {
  id             String    @id @default(cuid())
  familyId       String

  // Encrypted PII fields (AES-256-GCM)
  nameEnc        String    // Encrypted JSON containing name + birthDate
  encIv          String    // Base64 IV
  encAuthTag     String    // Base64 auth tag
  encSalt        String    // Base64 salt for HKDF
  encVersion     Int       @default(1)  // Key version for rotation

  gender         String?   // MALE, FEMALE, OTHER
  diagnosisName  String?
  diagnosisDate  DateTime?
  notes          String?

  // 발달 수준 (자유 텍스트, Phase 4에서 구조화 체크리스트로 고도화 예정)
  developmentalLevel Json?    // { language?: string, cognitive?: string, motor?: string, selfCare?: string, social?: string, overall?: string }

  // 센터/치료 정보
  centerInfo         Json?    // Array<{ name: string, type: string, frequency: string, currentGoal?: string }>

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  schedules      Schedule[]
  assessments    Assessment[]
  curricula      Curriculum[]
  activityLogs   ActivityLog[]
  reports        Report[]
  wellbeingCheckins ParentWellbeing[]
  emergencyEvents  EmergencyEvent[]
  sensoryProfiles  SensoryProfile[]
  researchMatches  ResearchUserMatch[]
  researchDigests  ResearchDigest[]
  clinicalReports  ClinicalReport[]

  @@index([familyId])
}

// ─── SCHEDULE ───────────────────────────────────────────

model Schedule {
  id             String           @id @default(cuid())
  childId        String
  familyId       String
  title          String
  description    String?
  category       ScheduleCategory @default(OTHER)
  startTime      DateTime
  endTime        DateTime
  isAllDay       Boolean          @default(false)

  // Recurrence
  recurrenceType RecurrenceType   @default(NONE)
  recurrenceRule Json?            // { daysOfWeek?: number[], interval?: number, endDate?: string }
  recurrenceEnd  DateTime?
  exceptedDates  Json?            // string[] — dates (YYYY-MM-DD) excluded from recurrence expansion

  // Metadata
  location       String?
  notes          String?
  color          String?          // Hex color override

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([familyId])
  @@index([startTime])
  @@index([childId, startTime])
}

// ─── QUESTIONNAIRE ──────────────────────────────────────

model Questionnaire {
  id             String            @id @default(cuid())
  familyId       String
  type           QuestionnaireType @default(NON_LICENSED_USER_INPUT)
  licensedTool   LicensedTool?
  name           String
  description    String?
  domains        String[]          // e.g., ["COMMUNICATION", "SOCIAL", "MOTOR"]
  isActive       Boolean           @default(true)
  createdBy      String            // userId
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  family         Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items          QuestionnaireItem[]
  assessments    Assessment[]

  @@index([familyId])
  @@index([type])
}

model QuestionnaireItem {
  id               String        @id @default(cuid())
  questionnaireId  String
  domain           String        // COMMUNICATION, SOCIAL, MOTOR, COGNITIVE, EMOTIONAL, etc.
  text             String
  description      String?
  orderIndex       Int
  weight           Float         @default(1.0)
  createdAt        DateTime      @default(now())

  questionnaire    Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([domain])
}

// ─── ASSESSMENT ─────────────────────────────────────────

model Assessment {
  id               String             @id @default(cuid())
  childId          String
  familyId         String
  questionnaireId  String
  frequency        AssessmentFrequency @default(DAILY)
  notes            String?
  totalScore       Float?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  child            Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  family           Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  questionnaire    Questionnaire      @relation(fields: [questionnaireId], references: [id])
  scores           AssessmentScore[]
  mediaAttachments MediaAttachment[]

  @@index([childId])
  @@index([familyId])
  @@index([childId, createdAt])
}

model AssessmentScore {
  id             String   @id @default(cuid())
  assessmentId   String
  itemId         String
  domain         String
  score          Int      // 1-5
  notes          String?
  createdAt      DateTime @default(now())

  assessment     Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([domain])
}

model MediaAttachment {
  id           String   @id @default(cuid())
  assessmentId String
  s3Key        String
  s3Bucket     String
  fileName     String
  fileType     String   // image/jpeg, video/mp4, etc.
  fileSize     Int
  createdAt    DateTime @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// ─── LEGAL CONSENT ──────────────────────────────────────

model LegalConsent {
  id              String   @id @default(cuid())
  userId          String
  consentType     String   // TERMS_OF_SERVICE, PRIVACY_POLICY, LICENSED_TOOL_USE_<TOOL>
  consentVersion  String
  documentContent String?  // 동의 당시 표시된 실제 동의서 내용 (스냅샷)
  ipAddress       String?
  userAgent       String?
  consentedAt     DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
}

// ─── AI CONFIG ──────────────────────────────────────────

enum AiProvider {
  CLAUDE_BEDROCK
  CLAUDE_DIRECT
  GEMINI
  OPENAI
}

model AiConfig {
  id                String     @id @default(cuid())
  name              String                            // 사용자 지정 이름 (예: "Bedrock Sonnet 4.5")
  provider          AiProvider
  isActive          Boolean    @default(false)
  isDefault         Boolean    @default(false)

  // Encrypted credentials (same AES-256-GCM pattern as PII)
  encApiKey         String?
  encRegion         String?
  encAccessKeyId    String?
  encSecretKey      String?
  encIv             String?
  encAuthTag        String?
  encSalt           String?

  // Non-sensitive config
  modelId           String?
  maxTokens         Int        @default(4096)
  temperature       Float      @default(0.7)
  dailyBudgetLimit  Int        @default(100)

  lastTestedAt      DateTime?
  lastTestSuccess   Boolean?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([provider])
  @@index([isDefault])
}

// ─── CURRICULUM ─────────────────────────────────────────

model Curriculum {
  id              String           @id @default(cuid())
  childId         String
  familyId        String
  date            DateTime         // target date (date only)
  status          CurriculumStatus @default(PENDING)
  aiProvider      String?          // which provider generated this
  promptVersion   String?          // for tracking prompt iterations
  rawAiOutput     Json?            // full AI response (for debugging)
  weeklyGoal      String?          // AI-generated weekly goal
  activities      Json             // CurriculumActivity[] as JSON
  notes           String?
  generatedAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  child           Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  activityLogs    ActivityLog[]

  @@unique([childId, date])
  @@index([childId])
  @@index([familyId])
  @@index([date])
}

model ActivityLog {
  id             String         @id @default(cuid())
  curriculumId   String
  childId        String
  activityIndex  Int
  activityTitle  String
  result         ActivityResult
  durationMin    Int?
  notes          String?
  mediaUrls      Json?          // string[]
  loggedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())

  curriculum     Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  child          Child          @relation(fields: [childId], references: [id])
  comments       ActivityComment[]

  @@index([curriculumId])
  @@index([childId])
}

enum NotificationType {
  ASSESSMENT_DUE
  CURRICULUM_READY
  MILESTONE_ACHIEVED
  INPUT_REMINDER
  WEEKLY_INSIGHT_READY
  SYSTEM
  WELLBEING_REMINDER
  RESEARCH_READY
  EMERGENCY_PATTERN
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  childId     String?
  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
 }

model Report {
  id          String   @id @default(cuid())
  childId     String
  familyId    String
  year        Int
  month       Int
  htmlContent String   @db.Text
  createdAt   DateTime @default(now())

  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([childId, year, month])
  @@index([childId])
  @@index([familyId])
}

model BatchJob {
  id          String        @id @default(cuid())
  type        String        // e.g., 'CURRICULUM_GENERATION'
  status      BatchJobStatus @default(PENDING)
  targetDate  DateTime?
  totalItems  Int           @default(0)
  processedItems Int        @default(0)
  failedItems Int           @default(0)
  errors      Json?         // array of error messages
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([targetDate])
}

model AiFeatureConfig {
  id        String   @id @default(cuid())
  feature   String   @unique
  configId  String
  updatedAt DateTime @updatedAt
}

// ─── PHASE 4 MODELS ──────────────────────────────────────────

model ParentWellbeing {
  id          String   @id @default(cuid())
  userId      String
  childId     String
  familyId    String
  mood        Int      // 1-5: 1=very bad, 5=very good
  stressLevel Int      // 1-5: 1=very low, 5=very high
  notes       String?
  aiMessage   String?  @db.Text
  burnoutRisk String   @default("LOW") // LOW, MEDIUM, HIGH
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
  @@index([familyId])
  @@index([createdAt])
}

model EmergencyEvent {
  id            String   @id @default(cuid())
  childId       String
  familyId      String
  userId        String
  type          String   // MELTDOWN, SELF_INJURY, AGGRESSION, ELOPING, OTHER
  severity      String   // MILD, MODERATE, SEVERE
  trigger       String?
  durationMin   Int?
  interventions Json?    // string[]
  outcome       String?
  notes         String?
  aiPattern     String?  @db.Text
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  child         Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([familyId])
  @@index([occurredAt])
}

model SensoryProfile {
  id              String   @id @default(cuid())
  childId         String
  familyId        String
  visual          Int      // 1=hypersensitive, 3=typical, 5=hyposensitive
  auditory        Int
  tactile         Int
  vestibular      Int
  proprioception  Int
  olfactory       Int
  notes           String?
  aiRecommendations String? @db.Text
  createdAt       DateTime @default(now())

  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([familyId])
  @@index([createdAt])
}

model ResearchArticle {
  id            String   @id @default(cuid())
  pubmedId      String   @unique
  title         String
  authors       String[]
  abstract      String   @db.Text
  publishedAt   DateTime
  journal       String
  koreanSummary String?  @db.Text
  keyFindings   Json?    // string[]
  tags          String[]
  relevanceBase Float    @default(0) // base relevance 0-1
  fetchedAt     DateTime @default(now())

  userMatches   ResearchUserMatch[]

  @@index([publishedAt])
  @@index([fetchedAt])
}

model ResearchUserMatch {
  id           String   @id @default(cuid())
  articleId    String
  familyId     String
  childId      String?
  score        Float    @default(0)
  isBookmarked Boolean  @default(false)
  isRead       Boolean  @default(false)
  isArchived   Boolean  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  article      ResearchArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  family       Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child        Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@unique([articleId, familyId])
  @@index([familyId])
  @@index([childId])
  @@index([createdAt])
  @@index([isArchived])
}

model ResearchDigest {
  id          String   @id @default(cuid())
  familyId    String
  childId     String
  digest      String   @db.Text
  topArticles Json     @default("[]")
  createdAt   DateTime @default(now())

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([childId])
  @@index([createdAt])
}

model RoleAssignment {
  id          String    @id @default(cuid())
  familyId    String
  assignedTo  String
  assignedBy  String
  childId     String?
  title       String
  description String?
  date        String    // YYYY-MM-DD
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  assignedToUser User    @relation("AssignedToUser", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedByUser User    @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: Cascade)
  family         Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([date])
  @@index([assignedTo])
}

model ActivityComment {
  id            String      @id @default(cuid())
  activityLogId String
  userId        String
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityLogId])
  @@index([userId])
}

// ============================================================
// Phase 5 — Licensing
// ============================================================

enum LicensedTool {
  M_CHAT_R_F
  CARS_2
  ABC
  ADOS_2
  SCQ
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model License {
  id          String        @id @default(cuid())
  tool        LicensedTool
  keyHash     String        // SHA-256 of the original license key
  familyId    String
  status      LicenseStatus @default(ACTIVE)
  activatedAt DateTime      @default(now())
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  family      Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([tool, familyId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// Phase 6 — Clinical Reports
// ============================================================

enum ClinicalReportSource {
  MANUAL
  IMAGE_IMPORT
}

model ClinicalReport {
  id               String               @id @default(cuid())
  childId          String
  assessmentTool   String               // 예: "PRES", "K-WISC-V", "CARS-2", "언어발달검사"
  assessmentDate   DateTime?
  evaluatorType    String?              // 예: "언어치료사", "임상심리사", "소아과 전문의"
  institution      String?              // 기관명
  sectionScores    Json                 // [{ name: "표현어휘", score: 36, unit: "점", percentile: 5 }]
  totalScore       Float?
  totalScoreUnit   String?              // "점", "지수", "백분위"
  clinicalFindings String?              // 소견 전문
  source           ClinicalReportSource @default(MANUAL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  child            Child                @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([assessmentDate])
  @@index([createdAt])
}
