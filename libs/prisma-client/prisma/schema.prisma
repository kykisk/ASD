datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SYSTEM_ADMIN
  FAMILY_ADMIN
  FAMILY_MEMBER
  THERAPIST
}

enum OAuthProvider {
  GOOGLE
  KAKAO
  APPLE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String
  role             UserRole  @default(FAMILY_ADMIN)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  phone            String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  familyMembers    FamilyMember[]
  legalConsents    LegalConsent[]

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  deviceInfo String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

enum ScheduleCategory {
  THERAPY
  EDUCATION
  FREE_PLAY
  MEAL
  SLEEP
  OTHER
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  SPECIFIC_DAYS
  CUSTOM
}

enum QuestionnaireType {
  LICENSED
  NON_LICENSED_USER_INPUT
  NON_LICENSED_AI_GENERATED
}

enum AssessmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ActivityResult {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum CurriculumStatus {
  PENDING
  GENERATED
  CONFIRMED
  COMPLETED
  FAILED
}

enum BatchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── FAMILY ─────────────────────────────────────────────

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        FamilyMember[]
  children       Child[]
  schedules      Schedule[]
  questionnaires Questionnaire[]
  assessments    Assessment[]
  curricula      Curriculum[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  role      UserRole @default(FAMILY_MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([userId])
  @@index([familyId])
}

// ─── CHILD ──────────────────────────────────────────────

model Child {
  id             String    @id @default(cuid())
  familyId       String

  // Encrypted PII fields (AES-256-GCM)
  nameEnc        String    // Encrypted JSON containing name + birthDate
  encIv          String    // Base64 IV
  encAuthTag     String    // Base64 auth tag
  encSalt        String    // Base64 salt for HKDF
  encVersion     Int       @default(1)  // Key version for rotation

  gender         String?   // MALE, FEMALE, OTHER
  diagnosisName  String?
  diagnosisDate  DateTime?
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  schedules      Schedule[]
  assessments    Assessment[]
  curricula      Curriculum[]
  activityLogs   ActivityLog[]

  @@index([familyId])
}

// ─── SCHEDULE ───────────────────────────────────────────

model Schedule {
  id             String           @id @default(cuid())
  childId        String
  familyId       String
  title          String
  description    String?
  category       ScheduleCategory @default(OTHER)
  startTime      DateTime
  endTime        DateTime
  isAllDay       Boolean          @default(false)

  // Recurrence
  recurrenceType RecurrenceType   @default(NONE)
  recurrenceRule Json?            // { daysOfWeek?: number[], interval?: number, endDate?: string }
  recurrenceEnd  DateTime?
  exceptedDates  Json?            // string[] — dates (YYYY-MM-DD) excluded from recurrence expansion

  // Metadata
  location       String?
  notes          String?
  color          String?          // Hex color override

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([familyId])
  @@index([startTime])
  @@index([childId, startTime])
}

// ─── QUESTIONNAIRE ──────────────────────────────────────

model Questionnaire {
  id             String            @id @default(cuid())
  familyId       String
  type           QuestionnaireType @default(NON_LICENSED_USER_INPUT)
  name           String
  description    String?
  domains        String[]          // e.g., ["COMMUNICATION", "SOCIAL", "MOTOR"]
  isActive       Boolean           @default(true)
  createdBy      String            // userId
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  family         Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items          QuestionnaireItem[]
  assessments    Assessment[]

  @@index([familyId])
  @@index([type])
}

model QuestionnaireItem {
  id               String        @id @default(cuid())
  questionnaireId  String
  domain           String        // COMMUNICATION, SOCIAL, MOTOR, COGNITIVE, EMOTIONAL, etc.
  text             String
  description      String?
  orderIndex       Int
  weight           Float         @default(1.0)
  createdAt        DateTime      @default(now())

  questionnaire    Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([domain])
}

// ─── ASSESSMENT ─────────────────────────────────────────

model Assessment {
  id               String             @id @default(cuid())
  childId          String
  familyId         String
  questionnaireId  String
  frequency        AssessmentFrequency @default(DAILY)
  notes            String?
  totalScore       Float?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  child            Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  family           Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  questionnaire    Questionnaire      @relation(fields: [questionnaireId], references: [id])
  scores           AssessmentScore[]
  mediaAttachments MediaAttachment[]

  @@index([childId])
  @@index([familyId])
  @@index([childId, createdAt])
}

model AssessmentScore {
  id             String   @id @default(cuid())
  assessmentId   String
  itemId         String
  domain         String
  score          Int      // 1-5
  notes          String?
  createdAt      DateTime @default(now())

  assessment     Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([domain])
}

model MediaAttachment {
  id           String   @id @default(cuid())
  assessmentId String
  s3Key        String
  s3Bucket     String
  fileName     String
  fileType     String   // image/jpeg, video/mp4, etc.
  fileSize     Int
  createdAt    DateTime @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// ─── LEGAL CONSENT ──────────────────────────────────────

model LegalConsent {
  id              String   @id @default(cuid())
  userId          String
  consentType     String   // TERMS_OF_SERVICE, PRIVACY_POLICY, LICENSED_TOOL_USE
  consentVersion  String
  ipAddress       String?
  userAgent       String?
  consentedAt     DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
}

// ─── AI CONFIG ──────────────────────────────────────────

enum AiProvider {
  CLAUDE_BEDROCK
  CLAUDE_DIRECT
  GEMINI
  OPENAI
}

model AiConfig {
  id                String     @id @default(cuid())
  provider          AiProvider @unique
  isActive          Boolean    @default(false)
  isDefault         Boolean    @default(false)

  // Encrypted credentials (same AES-256-GCM pattern as PII)
  encApiKey         String?    // Encrypted API key
  encRegion         String?    // Encrypted region (for Bedrock)
  encAccessKeyId    String?    // Encrypted AWS access key (for Bedrock)
  encSecretKey      String?    // Encrypted AWS secret key (for Bedrock)
  encIv             String?
  encAuthTag        String?
  encSalt           String?

  // Non-sensitive config
  modelId           String?    // e.g., "claude-sonnet-4-20250514"
  maxTokens         Int        @default(4096)
  temperature       Float      @default(0.7)
  dailyBudgetLimit  Int        @default(100)  // max API calls per day

  lastTestedAt      DateTime?
  lastTestSuccess   Boolean?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// ─── CURRICULUM ─────────────────────────────────────────

model Curriculum {
  id              String           @id @default(cuid())
  childId         String
  familyId        String
  date            DateTime         // target date (date only)
  status          CurriculumStatus @default(PENDING)
  aiProvider      String?          // which provider generated this
  promptVersion   String?          // for tracking prompt iterations
  rawAiOutput     Json?            // full AI response (for debugging)
  weeklyGoal      String?          // AI-generated weekly goal
  activities      Json             // CurriculumActivity[] as JSON
  notes           String?
  generatedAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  child           Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  activityLogs    ActivityLog[]

  @@unique([childId, date])
  @@index([childId])
  @@index([familyId])
  @@index([date])
}

model ActivityLog {
  id             String         @id @default(cuid())
  curriculumId   String
  childId        String
  activityIndex  Int
  activityTitle  String
  result         ActivityResult
  durationMin    Int?
  notes          String?
  mediaUrls      Json?          // string[]
  loggedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())

  curriculum     Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  child          Child          @relation(fields: [childId], references: [id])

  @@index([curriculumId])
  @@index([childId])
}

model BatchJob {
  id          String        @id @default(cuid())
  type        String        // e.g., 'CURRICULUM_GENERATION'
  status      BatchJobStatus @default(PENDING)
  targetDate  DateTime?
  totalItems  Int           @default(0)
  processedItems Int        @default(0)
  failedItems Int           @default(0)
  errors      Json?         // array of error messages
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([targetDate])
}
