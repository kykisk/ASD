# ============================================================
# AutiCare Environment Configuration
# Copy to .env and fill in actual values
# ============================================================

# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development                    # development | staging | production
PORT=3000                               # API server port
API_PREFIX=v1                           # Global API prefix

# ─── Database (PostgreSQL 16) ───────────────────────────────
DATABASE_URL=postgresql://auticare:password@localhost:5432/auticare?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis 7 ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=auticare:

# ─── JWT Authentication ─────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_ACCESS_TTL=900                      # 15 minutes in seconds
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_TTL=604800                  # 7 days in seconds
JWT_ISSUER=auticare

# ─── Encryption (AES-256-GCM for PII) ──────────────────────
ENCRYPTION_MASTER_KEY=base64-encoded-32-byte-key
ENCRYPTION_ALGORITHM=aes-256-gcm       # Do not change

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
CORS_CREDENTIALS=true

# ─── Frontend URL ───────────────────────────────────────────
WEB_URL=http://localhost:4200

# ─── OAuth Providers ────────────────────────────────────────
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/v1/auth/kakao/callback

# Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./keys/apple-auth-key.p8
APPLE_CALLBACK_URL=http://localhost:3000/v1/auth/apple/callback

# ─── AI Providers ───────────────────────────────────────────
# Claude via AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Claude Direct (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default AI provider (bedrock | anthropic | gemini | openai)
AI_DEFAULT_PROVIDER=bedrock

# ─── AWS S3 ─────────────────────────────────────────────────
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=auticare-uploads
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=                        # Leave empty for AWS, set for MinIO local

# ─── Email / Notifications ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@auticare.com

# Push notifications (FCM)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_TTL=60                       # Window in seconds
RATE_LIMIT_MAX=100                      # Max requests per window
RATE_LIMIT_AUTH_MAX=5                   # Max auth attempts per window
