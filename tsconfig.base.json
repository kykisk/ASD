{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@auticare/ai-provider": ["libs/ai-provider/src/index.ts"],
      "@auticare/api-client": ["libs/api-client/src/index.ts"],
      "@auticare/dto": ["libs/shared/dto/src/index.ts"],
      "@auticare/encryption": ["libs/encryption/src/index.ts"],
      "@auticare/prisma-client": ["libs/prisma-client/src/index.ts"],
      "@auticare/shared-constants": ["libs/shared/constants/src/index.ts"],
      "@auticare/shared-types": ["libs/shared/types/src/index.ts"],
      "@auticare/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@auticare/validators": ["libs/shared/validators/src/index.ts"]
    }
  }
}
