{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "app.config.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "metro.config.js", "babel.config.js"],
  "references": [
    {
      "path": "../../libs/shared/dto"
    },
    {
      "path": "../../libs/shared/utils"
    },
    {
      "path": "../../libs/shared/constants"
    },
    {
      "path": "../../libs/shared/types"
    },
    {
      "path": "../../libs/api-client"
    }
  ]
}
